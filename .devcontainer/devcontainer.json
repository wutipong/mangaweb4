{
	"name": "MangaWeb4 Backend (Go + PostgreSQL)",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"ms-azuretools.vscode-docker",
				"mtxr.sqltools",
				"mtxr.sqltools-driver-pg",
				"zxh404.vscode-proto3"
			],
			"settings": {
				"go.toolsManagement.checkForUpdates": "local",
				"go.useLanguageServer": true,
				"go.gopath": "/go",
				"go.goroot": "/usr/local/go",
				"[go]": {
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.organizeImports": "explicit"
					}
				},
				"sqltools.connections": [
					{
						"name": "MangaWeb DB",
						"driver": "PostgreSQL",
						"server": "db",
						"port": 5432,
						"database": "manga",
						"username": "postgres",
						"password": "password"
					}
				]
			}
		}
	},

	"forwardPorts": [8972, 5432],
	"portsAttributes": {
		"8972": {
			"label": "gRPC Server",
			"onAutoForward": "notify"
		},
		"5432": {
			"label": "PostgreSQL",
			"onAutoForward": "silent"
		}
	},

	"remoteEnv": {
		"MANGAWEB_DB": "postgres://postgres:password@db:5432/manga?sslmode=disable",
		"MANGAWEB_DB_TYPE": "postgres",
		"MANGAWEB_ADDRESS": ":8972",
		"MANGAWEB_DEBUG": "true",
		"MANGAWEB_DATA_PATH": "/workspaces/${localWorkspaceFolderBasename}/backend/data",
		"MANGAWEB_CACHE_PATH": "/workspaces/${localWorkspaceFolderBasename}/backend/cache"
	},

	"postCreateCommand": "cd backend && go mod download",

	"remoteUser": "vscode"
}
