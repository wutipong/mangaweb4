{
  "name": "MangaWeb4 Backend (Go + PostgreSQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/",
  "runServices": ["oidc"],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/go:": {
      "golangciLintVersion": "2.11.4",
      "version": "latest"
    },
    "ghcr.io/azutake/devcontainer-features/go-packages-install:0": {
      "PACKAGES": "google.golang.org/protobuf/cmd/protoc-gen-go@latest,google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest,entgo.io/ent/cmd/ent@latest,github.com/cshum/vipsgen/cmd/vipsgen@latest"
    },
    "ghcr.io/devcontainers-extra/features/protoc:1": {
      "version": "latest"
    },

    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "postgresql-client, python3, libvips-dev, libvips-tools, libwebp-dev"
    },
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "latest"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "DrBlury.protobuf-vsc",
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "humao.rest-client"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go",
        "[go]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "[javascript]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[svelte]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "svelte.svelte-vscode"
        },
        "sqltools.connections": [
          {
            "name": "MangaWeb DB",
            "driver": "PostgreSQL",
            "server": "db",
            "port": 5432,
            "database": "postgres",
            "username": "postgres",
            "password": "password"
          }
        ]
      }
    }
  },

  "forwardPorts": [5173, 8972, "db:5432", "oidc:5556"],
  "portsAttributes": {
    "5173": {
      "label": "Application",
      "onAutoForward": "notify"
    },
    "8972": {
      "label": "gRPC Server",
      "onAutoForward": "notify"
    },
    "db:5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "oidc:5556": {
      "label": "OIDC Provider",
      "onAutoForward": "notify"
    }
  },

  "remoteUser": "vscode"
}
