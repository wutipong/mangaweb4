		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.9.0",
		"jiti": "^2.6.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
