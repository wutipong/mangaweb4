{
	"name": "mangaweb4-frontend",
	"version": "0.5.2",
	"private": true,
	"scripts": {
		"dev": "vite dev --host | pino-pretty ",
		"build": "vite build",
		"preview": "vite preview | pino-pretty",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"generate-grpc": "protoc --ts_out=src/lib/grpc --proto_path=../grpc history.proto maintenance.proto manga.proto tag.proto types.proto system.proto user.proto",
		"svelte-check": "svelte-check",
		"eslint": "eslint ."
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
